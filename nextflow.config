manifest {
    name            = 'mvp-wgs-germline'
    description     = 'MVP WGS germline analysis pipeline on Google Cloud Batch'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
}

// ─── Parameters ───────────────────────────────────────────────────────────────
// All values below are defaults for this deployment.
// Override at runtime with --param_name <value> or a custom params file (--params-file).

params {

    // ── Input (required) ────────────────────────────────────────────────────
    // Path to a CSV file with a header column named 'sample_id'.
    // One sample per row. See assets/samplesheet_template.csv.
    // Use scripts/generate_samplesheet.py to auto-generate from GCS.
    samplesheet = null

    // ── GCP infrastructure ──────────────────────────────────────────────────
    project_id  = 'YOUR_PROJECT_ID'
    region      = 'us-west1'
    bucket_name = 'YOUR_BUCKET'

    // Nextflow uses this GCS path to stage task scripts and bookkeeping files.
    // It does NOT store DRAGEN outputs here — those go directly to output_files/
    // under bucket_name (managed entirely within run_dragen.sh).
    work_dir    = 'gs://YOUR_BUCKET/nextflow-work'

    // ── DRAGEN ──────────────────────────────────────────────────────────────
    // Update dragen_version when deploying a new DRAGEN release.
    // All other settings (flags, analysis modes) are fixed in run_dragen.sh
    // and are intentionally not parameterised to keep production runs stable.
    dragen_version           = '4.4.7'
    reference_path           = 'gs://YOUR_BUCKET/reference/hg38-alt_masked.graph.cnv.hla.methyl_cg.rna_v5'
    license_credentials_path = 'gs://YOUR_BUCKET/secrets/dragen_credentials.txt'

    // ── Compute ─────────────────────────────────────────────────────────────
    // Illumina validated 5 machine types for DRAGEN on GCP (us-west1, ~35x WGS,
    // GCP-only costs — additional DRAGEN licensing costs apply separately).
    // Pilot observed $1.83/sample at ~30x coverage using c3d-standard-90 Spot.
    // Cost and processing time scale linearly with FASTQ size (R² = 0.9953).
    //
    // VM size            Run time    Spot $/sample   Standard $/sample
    // n2d-standard-96    2 h 51 min  $3.19           $10.03
    // c3d-standard-60    3 h 15 min  $2.63           $9.75
    // c3d-standard-90    2 h 13 min  $2.39           $9.65   ← default (cheapest Spot)
    // c4d-standard-64    2 h 29 min  $3.97           $8.55
    // c4d-standard-96    1 h 44 min  $3.78           $8.56   ← fastest
    //
    // Override at runtime: --machine_type c4d-standard-96
    machine_type = 'c3d-standard-90'
    disk_size    = '2000 GB'

    // Maximum number of Cloud Batch jobs submitted and active at one time.
    // Tune this against your c3d-standard-90 quota in us-west1.
    // IMPORTANT: a GCP quota increase is mandatory before scaling beyond the
    // default quota ceiling (~50–200 concurrent VMs). Contact your Google
    // account team to request a higher quota before starting a large run.
    queue_size   = 500

    // ── Dry-run ─────────────────────────────────────────────────────────────
    // When true, run_dragen_mock.sh is executed instead of run_dragen.sh.
    // No DRAGEN binary is downloaded and no license credits are consumed.
    // Enable via -profile test (see profiles block below).
    dry_run      = false
}

// ─── Work directory ───────────────────────────────────────────────────────────
workDir = params.work_dir

// ─── GCP configuration ────────────────────────────────────────────────────────
includeConfig 'conf/gcp.config'

// ─── Profiles ─────────────────────────────────────────────────────────────────
profiles {

    // End-to-end infrastructure test: submits real Cloud Batch jobs with a mock
    // DRAGEN step (20-second sleep + dummy output files). Validates GCP auth,
    // spot provisioning, and GCS read/write without consuming DRAGEN credits.
    test {
        params.dry_run      = true
        params.machine_type = 'e2-standard-4'
        params.disk_size    = '50 GB'
        params.queue_size   = 5
    }
}
