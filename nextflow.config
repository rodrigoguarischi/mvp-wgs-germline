manifest {
    name            = 'dragen-gcp'
    description     = 'DRAGEN whole-genome analysis pipeline on Google Cloud Batch'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
}

// ─── Parameters ───────────────────────────────────────────────────────────────
// All values below are defaults for this deployment.
// Override at runtime with --param_name <value> or a custom params file (--params-file).

params {

    // ── Input (required) ────────────────────────────────────────────────────
    // Path to a CSV file with a header column named 'sample_id'.
    // One sample per row. See assets/samplesheet_template.csv.
    samplesheet = null

    // ── GCP infrastructure ──────────────────────────────────────────────────
    project_id  = 'YOUR_PROJECT_ID'
    region      = 'us-west1'
    bucket_name = 'YOUR_BUCKET'

    // Nextflow uses this GCS path to stage task scripts and bookkeeping files.
    // It does NOT store DRAGEN outputs here — those go directly to output_files/
    // under bucket_name (managed entirely within run_dragen.sh).
    work_dir    = 'gs://YOUR_BUCKET/nextflow-work'

    // ── DRAGEN ──────────────────────────────────────────────────────────────
    // Update dragen_version when deploying a new DRAGEN release.
    // All other settings (flags, analysis modes) are fixed in run_dragen.sh
    // and are intentionally not parameterised to keep production runs stable.
    dragen_version           = '4.4.7'
    reference_path           = 'gs://YOUR_BUCKET/reference/hg38-alt_masked.graph.cnv.hla.methyl_cg.rna_v5'
    license_credentials_path = 'gs://YOUR_BUCKET/dragen_credentials.txt'

    // ── Compute ─────────────────────────────────────────────────────────────
    machine_type = 'c3d-standard-90'
    disk_size    = '2000 GB'

    // Maximum number of Cloud Batch jobs submitted and active at one time.
    // Tune this against your c3d-standard-90 quota in us-west1.
    // IMPORTANT: a GCP quota increase is mandatory before scaling beyond the
    // default quota ceiling (~50–200 concurrent VMs). Contact your Google
    // account team to request a higher quota before starting a large run.
    queue_size   = 500
}

// ─── Work directory ───────────────────────────────────────────────────────────
workDir = params.work_dir

// ─── GCP configuration ────────────────────────────────────────────────────────
includeConfig 'conf/gcp.config'
