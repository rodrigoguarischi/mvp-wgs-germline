// ─── Docker ───────────────────────────────────────────────────────────────────
docker {
    enabled = true
}

// ─── Google Cloud ─────────────────────────────────────────────────────────────
google {
    project  = params.project_id
    location = params.region

    batch {
        // Global cost-tracking labels applied to every Cloud Batch job.
        // Per-sample labels (e.g. sample-id) are set inside run_dragen.sh
        // because Cloud Batch jobs are created per-sample by Nextflow.
        labels = [
            'pipeline'       : 'mvp-wgs-germline',
            'project-name'   : 'dragen-poc',
            'dragen-version' : params.dragen_version.replace('.', '-')
        ]
    }
}

// ─── Executor ─────────────────────────────────────────────────────────────────
executor {
    name            = 'google-batch'

    // Controls how many Cloud Batch jobs are active at once.
    // Must not exceed your c3d-standard-90 quota in us-west1.
    queueSize       = params.queue_size

    // How often Nextflow polls Cloud Batch for task status.
    pollInterval    = '60 sec'

    // Throttle job submission to avoid Cloud Batch API rate-limit errors
    // when launching large numbers of samples.
    submitRateLimit = '10 / 1 min'
}

// ─── Process defaults ─────────────────────────────────────────────────────────
process {
    executor = 'google-batch'

    withName: 'DRAGEN' {
        // Container image built from app/Dockerfile and pushed to Artifact Registry.
        // Rebuild and re-push the image whenever app/Dockerfile or app/run_dragen.sh changes.
        container   = "us-west1-docker.pkg.dev/${params.project_id}/dragen/dragen-runner:latest"

        machineType = params.machine_type
        disk        = params.disk_size

        // Hard cap: DRAGEN analysis on a single WGS sample should never exceed 24 h.
        time        = '24h'

        // ── Retry / spot strategy ────────────────────────────────────────────
        // Attempts 1–3 run on Spot VMs (low cost, may be preempted).
        // Attempt 4 runs on a Standard VM (guaranteed capacity, higher cost).
        // This means a sample will always complete unless DRAGEN itself errors.
        //
        // spot is a closure: evaluates task.attempt at job-submission time.
        spot          { task.attempt <= 3 }

        maxRetries    3

        // Retry on any non-zero exit code (covers spot preemption signals and
        // transient infrastructure failures). Nextflow terminates after maxRetries + 1
        // total attempts (4), so 'retry' here is equivalent to the full retry table.
        errorStrategy 'retry'
    }
}
